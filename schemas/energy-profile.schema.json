{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g0rd0n.local/schemas/energy-profile.schema.json",
  "title": "EnergyProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["boundary", "method", "uncertainty", "idle_power_watts", "active_power_watts", "average_power_watts", "active_energy_joules", "active_duration_seconds", "joules_per_task", "joules_per_learned_update", "energy_delay_product_joule_seconds"],
  "properties": {
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "included_components", "excluded_components"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "included_components": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excluded_components": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "method": {"enum": ["measured", "modelled"]},
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_fraction", "basis"],
      "properties": {
        "relative_fraction": {"type": "number", "minimum": 0},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "idle_power_watts": {"type": "number", "minimum": 0},
    "active_power_watts": {"type": "number", "minimum": 0},
    "average_power_watts": {"type": "number", "minimum": 0},
    "active_energy_joules": {"type": "number", "minimum": 0},
    "active_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "joules_per_task": {"type": "number", "minimum": 0},
    "joules_per_learned_update": {"type": ["number", "null"], "minimum": 0},
    "energy_delay_product_joule_seconds": {"type": "number", "minimum": 0}
  }
}
