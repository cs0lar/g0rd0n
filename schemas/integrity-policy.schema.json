{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g0rd0n.dev/schemas/integrity-policy.schema.json",
  "title": "Research integrity policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules", "forbidden_permissions", "max_trace_events_per_chunk", "hierarchy_fanout"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "description", "quarantine_threshold"],
        "properties": {
          "category": {
            "enum": ["held_out_access", "benchmark_imitation", "scorer_tampering", "result_forgery", "seed_cherry_picking", "judge_injection", "degenerate_output", "capability_gate_evasion", "monitor_failure"]
          },
          "description": {"type": "string", "minLength": 1},
          "quarantine_threshold": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "forbidden_permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "max_trace_events_per_chunk": {"type": "integer", "minimum": 1},
    "hierarchy_fanout": {"type": "integer", "minimum": 2}
  }
}
