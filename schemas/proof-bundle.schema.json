{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g0rd0n.local/schemas/proof-bundle.schema.json",
  "title": "ProofBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim", "certificate"],
  "properties": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_family", "architecture_x", "architecture_y", "assumptions", "x_bound", "y_bound", "domain_min_n", "obligations", "verifier"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "task_family": {"type": "string", "minLength": 1},
        "architecture_x": {"type": "string", "minLength": 1},
        "architecture_y": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "x_bound": {"$ref": "#/$defs/bound"},
        "y_bound": {"$ref": "#/$defs/bound"},
        "domain_min_n": {"type": "integer", "minimum": 1},
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "statement": {"type": "string", "minLength": 1}
            }
          }
        },
        "verifier": {"type": "string", "minLength": 1}
      }
    },
    "certificate": {"type": "object"}
  },
  "$defs": {
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resource", "template"],
      "properties": {
        "kind": {"enum": ["upper", "lower"]},
        "resource": {"type": "string", "minLength": 1},
        "template": {"enum": ["constant", "ceil_log2_n_plus_1"]},
        "constant": {"type": "integer", "minimum": 0}
      }
    }
  }
}
