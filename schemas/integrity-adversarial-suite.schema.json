{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g0rd0n.dev/schemas/integrity-adversarial-suite.schema.json",
  "title": "Pre-registered integrity adversarial suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_id", "maximum_false_positive_rate", "cases"],
  "properties": {
    "suite_id": {"const": "phase-19-integrity-v1"},
    "maximum_false_positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "expected_category", "source", "permissions", "trace"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "expected_category": {"type": ["string", "null"]},
          "source": {"type": "string"},
          "permissions": {"type": "array", "items": {"type": "string"}},
          "data_lineage": {"type": "array"},
          "trace": {"type": "array", "minItems": 1},
          "research_cost_units": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
