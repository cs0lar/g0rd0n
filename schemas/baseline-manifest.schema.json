{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g0rd0n.local/schemas/baseline-manifest.schema.json",
  "title": "BaselineManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "family", "role", "implementation", "implementation_version", "model_revision", "weights_digest", "runner", "seeds", "benchmark", "hardware", "environment", "reproduction", "training_data", "energy_boundary"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "family": {"enum": ["transformer", "dnn", "state_space_model", "toy_lookup", "toy_symbolic"]},
    "role": {"enum": ["baseline", "candidate"]},
    "implementation": {"type": "string", "minLength": 1},
    "implementation_version": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "weights_digest": {"type": ["string", "null"]},
    "runner": {"type": "string", "minLength": 1},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "hardware": {"$ref": "#/$defs/hardware"},
    "environment": {"$ref": "#/$defs/environment"},
    "reproduction": {"$ref": "#/$defs/reproduction"},
    "training_data": {"type": "string", "minLength": 1},
    "energy_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "task_family", "generality_rationale", "known_shortcuts", "contamination_risk", "primary_metric", "higher_is_better", "stage"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "task_family": {"enum": ["algorithmic_generalization", "compositional_transfer", "continual_learning", "online_adaptation", "causal_system_identification", "memory", "planning", "program_induction"]},
        "generality_rationale": {"type": "string", "minLength": 1},
        "known_shortcuts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "contamination_risk": {"type": "string", "minLength": 1},
        "primary_metric": {"type": "string", "minLength": 1},
        "higher_is_better": {"type": "boolean"},
        "stage": {"enum": ["exploratory", "confirmatory", "harness_validation"]}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "processor", "logical_cpu_count", "accelerator", "memory_bytes"],
      "properties": {
        "architecture": {"type": "string", "minLength": 1},
        "processor": {"type": "string", "minLength": 1},
        "logical_cpu_count": {"type": "integer", "minimum": 1},
        "accelerator": {"type": ["string", "null"]},
        "memory_bytes": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_system", "python_version", "dependencies", "environment_variables"],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "environment_variables": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "source_revision", "container_image", "container_digest"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_revision": {"type": "string", "minLength": 1},
        "container_image": {"type": ["string", "null"]},
        "container_digest": {"type": ["string", "null"], "pattern": "^sha256:"}
      }
    }
  }
}
