{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g0rd0n.local/schemas/resource.schema.json",
  "title": "Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "capabilities", "cost_model", "latency_model", "reliability", "rate_limit", "context_limits", "permissions", "provenance"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["human", "model", "program", "theorem_prover", "simulator", "benchmark", "knowledge_source", "external_channel", "hardware_target"]},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_call", "description"],
      "properties": {
        "per_call": {"$ref": "#/$defs/cost"},
        "description": {"type": "string"}
      }
    },
    "latency_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_ms", "maximum_ms", "description"],
      "properties": {
        "expected_ms": {"type": "integer", "minimum": 0},
        "maximum_ms": {"type": "integer", "minimum": 1},
        "description": {"type": "string"}
      }
    },
    "reliability": {"type": "number", "minimum": 0, "maximum": 1},
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "period_seconds"],
      "properties": {
        "calls": {"type": "integer", "minimum": 1},
        "period_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "context_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_bytes", "max_output_bytes"],
      "properties": {
        "max_input_bytes": {"type": "integer", "minimum": 1},
        "max_output_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/permission"}
    },
    "provenance": {"type": "string", "minLength": 1},
    "context_description": {"type": "string"},
    "historical_performance": {"type": "string"}
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["string", "integer", "number", "boolean", "object", "array"]},
        "required": {"type": "boolean"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "inputs", "outputs", "required_permissions", "default_timeout_seconds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "required_permissions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/permission"}},
        "default_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "permission": {
      "enum": ["read_local", "write_local", "execute", "network", "external_write", "human_attention"]
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency_micros", "tokens", "calls", "wall_time_ms"],
      "properties": {
        "currency_micros": {"type": "integer", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "calls": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
