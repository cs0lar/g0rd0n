{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g0rd0n.local/schemas/campaign-preregistration.schema.json",
  "title": "CampaignPreregistration",
  "type": "object",
  "required": ["id", "registered_before_results", "registration_scope", "study_stage", "question", "candidate", "baselines", "task_families", "evaluation", "resource_constraints", "energy_boundary", "success_thresholds", "falsifiers", "total_campaign_budget"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "registered_before_results": {"const": true},
    "registration_scope": {"type": "string", "minLength": 1},
    "study_stage": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "candidate": {"type": "object"},
    "baselines": {"type": "array", "minItems": 2},
    "task_families": {"type": "array", "minItems": 2, "uniqueItems": true},
    "evaluation": {"type": "object"},
    "resource_constraints": {"type": "object"},
    "energy_boundary": {"type": "object"},
    "success_thresholds": {"type": "object"},
    "falsifiers": {"type": "array", "minItems": 1},
    "total_campaign_budget": {"type": "object"}
  }
}
