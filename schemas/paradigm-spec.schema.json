{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g0rd0n.local/schemas/paradigm-spec.schema.json",
  "title": "ParadigmSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "runner", "primitives", "state", "memory", "learning_rule", "inference_rule", "communication", "adaptation", "hardware_assumptions", "complexity_claims", "energy_hypothesis", "falsifiers"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "runner": {"type": "string", "minLength": 1},
    "primitives": {"$ref": "#/$defs/nonEmptyStrings"},
    "state": {"$ref": "#/$defs/nonEmptyStrings"},
    "memory": {"$ref": "#/$defs/nonEmptyStrings"},
    "learning_rule": {"type": "string", "minLength": 1},
    "inference_rule": {"type": "string", "minLength": 1},
    "communication": {"type": "string", "minLength": 1},
    "adaptation": {"type": "string", "minLength": 1},
    "hardware_assumptions": {"$ref": "#/$defs/nonEmptyStrings"},
    "complexity_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "bound", "assumptions"],
        "properties": {
          "resource": {"type": "string", "minLength": 1},
          "bound": {"type": "string", "minLength": 1},
          "assumptions": {"$ref": "#/$defs/nonEmptyStrings"}
        }
      }
    },
    "energy_hypothesis": {"type": "string", "minLength": 1},
    "falsifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation", "consequence"],
        "properties": {
          "observation": {"type": "string", "minLength": 1},
          "consequence": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
