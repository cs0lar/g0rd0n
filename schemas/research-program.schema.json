{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g0rd0n.local/schemas/research-program.schema.json",
  "title": "ResearchProgram",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "question", "hypotheses", "experiments", "budget", "escalation"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "hypotheses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budget": {"$ref": "#/$defs/cost"},
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_total_failures", "escalate_on_budget_denial", "escalate_on_review_rejection"],
      "properties": {
        "max_total_failures": {"type": "integer", "minimum": 1},
        "escalate_on_budget_denial": {"type": "boolean"},
        "escalate_on_review_rejection": {"type": "boolean"}
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "hypothesis_ids", "estimated_cost", "maximum_cost", "expected_value", "stop_condition", "max_attempts", "requires_human_review"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "hypothesis_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "estimated_cost": {"$ref": "#/$defs/cost"},
          "maximum_cost": {"$ref": "#/$defs/cost"},
          "expected_value": {"type": "string", "minLength": 1},
          "stop_condition": {"type": "string", "minLength": 1},
          "max_attempts": {"type": "integer", "minimum": 1},
          "requires_human_review": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency_micros", "tokens", "compute_ms", "energy_joules", "human_minutes"],
      "properties": {
        "currency_micros": {"type": "integer", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "compute_ms": {"type": "integer", "minimum": 0},
        "energy_joules": {"type": "number", "minimum": 0},
        "human_minutes": {"type": "number", "minimum": 0}
      }
    }
  }
}
